{
  "expo": {
    "name": "TravelWitch",
    "slug": "travelwitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icons/mycollection/png/app_icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelwitch.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyANRzgIniwwjDbW31gDIJ38iGpKdLng0yk"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelWitch needs your location to show trips on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/icons/mycollection/png/app_icon.png"
      },
      "package": "com.travelwitch.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyANRzgIniwwjDbW31gDIJ38iGpKdLng0yk"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icons/mycollection/png/app_icon.png",
      "pwa": {
        "name": "TravelWitch",
        "shortName": "TravelWitch",
        "description": "Premium Travel Companion & Budget Tracker",
        "backgroundColor": "#0D0D0D",
        "themeColor": "#FFD2AD",
        "display": "standalone",
        "orientation": "portrait",
        "icon": "./assets/icons/mycollection/png/app_icon.png",
        "splash": {
          "image": "./assets/icons/mycollection/png/app_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      }
    },
    "scheme": "travelwitch",
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1266748452983907~1522508148",
          "iosAppId": "ca-app-pub-1266748452983907~1522508148"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
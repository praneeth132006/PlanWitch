# Copy to aws/.env and fill in. Every value is optional.

# Region to deploy into.
AWS_REGION=ap-south-1

# Receives SNS notifications, CloudWatch alarms and AWS Budgets warnings.
ALERT_EMAIL=

# "From" address for the OTP email. Defaults to ALERT_EMAIL.
# AWS mails this address a verification link -- click it before testing OTP.
SENDER_EMAIL=

# Leave blank to let deploy.sh pick the best model available in the region.
BEDROCK_MODEL_ID=

# Budget alerts fire at 50% actual and 100% forecast of this amount.
MONTHLY_BUDGET_USD=5

# Shown as a banner on the demo console. Quote it -- the values contain spaces.
RESTRICTED_SERVICES=""
